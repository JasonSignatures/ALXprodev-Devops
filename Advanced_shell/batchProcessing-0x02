#!/bin/bash
mkdir -p pokemon_data
pokemons=("bulbasaur" "ivysaur" "venusaur" "charmander" "charmeleon")

for pokemon in "${pokemons[@]}"
do
  echo "Fetching data for $pokemon..."
  attempt=1
  success=0
  while [ $attempt -le 3 ]
  do
    response=$(curl -s -o "pokemon_data/${pokemon}.json" -w "%{http_code}" "https://pokeapi.co/api/v2/pokemon/${pokemon}")
    if [ "$response" = "200" ]
    then
      echo "Saved data to pokemon_data/${pokemon}.json ✅"
      success=1
      break
    else
      echo "Attempt $attempt failed for $pokemon (HTTP $response)"
      attempt=$((attempt + 1))
      sleep 2
    fi
  done

  if [ $success -ne 1 ]
  then
    echo "Error: Failed to fetch data for $pokemon after 3 attempts" >> errors.txt
  fi

  sleep 2
done
